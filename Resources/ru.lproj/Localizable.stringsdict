<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- В русском четыре категории:
     one  — 1, 21, 31 … (кроме 11)
     few  — 2–4, 22–24 … (кроме 12–14)
     many — 0, 5–20, 25–30 …
     other — дробные значения. -->
<plist version="1.0">
<dict>
    <key>menu.days</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld день</string>
            <key>few</key>
            <string>%lld дня</string>
            <key>many</key>
            <string>%lld дней</string>
            <key>other</key>
            <string>%lld дня</string>
        </dict>
    </dict>

    <key>menu.holiday.inDays</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>через %lld день</string>
            <key>few</key>
            <string>через %lld дня</string>
            <key>many</key>
            <string>через %lld дней</string>
            <key>other</key>
            <string>через %lld дня</string>
        </dict>
    </dict>

    <key>salary.payMonths</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Выплата за %lld месяц в год</string>
            <key>few</key>
            <string>Выплата за %lld месяца в год</string>
            <key>many</key>
            <string>Выплата за %lld месяцев в год</string>
            <key>other</key>
            <string>Выплата за %lld месяца в год</string>
        </dict>
    </dict>

    <key>holidays.status.loaded</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Загружен %lld день</string>
            <key>few</key>
            <string>Загружено %lld дня</string>
            <key>many</key>
            <string>Загружено %lld дней</string>
            <key>other</key>
            <string>Загружено %lld дня</string>
        </dict>
    </dict>

    <key>holidays.status.loadedCached</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Загружен %lld день, из кэша</string>
            <key>few</key>
            <string>Загружено %lld дня, из кэша</string>
            <key>many</key>
            <string>Загружено %lld дней, из кэша</string>
            <key>other</key>
            <string>Загружено %lld дня, из кэша</string>
        </dict>
    </dict>
</dict>
</plist>
