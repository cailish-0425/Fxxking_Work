"leaveReason.absurd.2" = "Le chat a caché mes chaussures sous le canapé et refuse de négocier.";
"leaveReason.absurd.3" = "La machine à laver a avalé une chaussette. Je dois être sur place pour diriger le sauvetage.";
"leaveReason.absurd.4" = "L'œuf de ce matin avait mauvaise mine. Rester assis aujourd'hui est déconseillé.";
"leaveReason.absurd.5" = "La perceuse du voisin dit qu'on ne sort pas aujourd'hui. Je la crois.";
"leaveReason.absurd.6" = "L'ascenseur m'a mal regardé. Je prendrai les escaliers. Ceux de la maison.";
"leaveReason.existential.1" = "J'ai besoin d'un jour pour vérifier que ce n'est pas lundi qui m'a inventé.";
"leaveReason.existential.2" = "Mon sentiment d'exister est en batterie faible ; il ne se recharge pas en marchant.";
"leaveReason.existential.3" = "L'âme et le corps ne se sont pas synchronisés ; aucun des deux ne doit arriver le premier.";
"leaveReason.existential.4" = "Je prends une journée pour comprendre pourquoi je suis là. Là, c'est le bureau.";
"leaveReason.existential.5" = "Mon sens de la vie est fermé pour la journée ; il y a un panneau sur la porte.";
"leaveReason.existential.6" = "La question « pourquoi travailler » arrive à échéance aujourd'hui ; à traiter en personne.";
"leaveReason.glitch.1" = "Mon horloge interne m'a déposé dans un autre fuseau ; je cherche le chemin du retour.";
"leaveReason.glitch.2" = "Le module sommeil a raté sa mise à jour ; je tourne en mode sans échec.";
"leaveReason.glitch.3" = "Le pilote caféine ne répond pas. Je l'ai redémarré trois fois.";
"leaveReason.glitch.4" = "Mon corps a installé une mise à jour dont je ne voulais pas ; je dois la finir à la maison.";
"leaveReason.glitch.5" = "Le cache des émotions est plein. Le vider prend une journée entière, sans interruption.";
"leaveReason.glitch.6" = "Le module d'attention est en révision ; la personne peut rester chez elle.";
"leaveReason.time.1" = "Aujourd'hui, je porte la même tenue que lundi. Je rentre me changer en un autre jour.";
"leaveReason.time.2" = "J'ai emprunté du sommeil hier ; l'échéance tombe aujourd'hui.";
"leaveReason.time.3" = "Le « plus tard » est arrivé plus tôt ; je dois être chez moi pour le recevoir.";
"leaveReason.time.4" = "Une partie de mon agenda s'est effondrée ce matin ; il faut la déblayer sur place.";
"leaveReason.time.5" = "Une heure supplémentaire est apparue sans propriétaire. J'attends chez moi qu'on la réclame.";
"leaveReason.time.6" = "Pour être à l'heure la semaine prochaine, je dois m'entraîner aujourd'hui à ne pas travailler.";
